SPRING_PROFILES_ACTIVE=dev
SPRING_DATASOURCE_URL=jdbc:h2:file:./data/enterprisewebagent
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=
SPRING_AI_OPENAI_API_KEY=
SPRING_AI_ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_MODEL=gpt-4o
ANTHROPIC_MODEL=claude-sonnet-4-20250514
APP_DEFAULT_PROVIDER=stub

# Ollama (local)
APP_OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# GitHub Copilot (uses gh CLI auth)
APP_COPILOT_ENABLED=false

# Codex (reads ~/.codex/auth.json)
APP_CODEX_ENABLED=false
APP_STREAM_TRANSPORT=websocket
APP_RUNTIME_MODE=hosted
APP_AUTH_ENABLED=false
APP_API_KEY_1=
APP_API_KEY_2=

